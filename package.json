{
	"name": "obsidian-awork-sync",
	"version": "0.1.0",
	"description": "Two-way sync between awork Docs and an Obsidian vault",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"roundtrip": "tsx scripts/roundtrip.ts",
		"connect": "tsx scripts/connect.ts",
		"dry-run": "tsx scripts/dry-run.ts"
	},
	"keywords": [
		"obsidian",
		"awork",
		"sync"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.10.2",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.24.2",
		"obsidian": "^1.7.2",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	}
}
